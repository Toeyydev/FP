// Folkpath availability prototype — data model.
// Availability = guide × date × 10 slots; assignment = guide × date × slot.
// Plus the account-provisioning layer (invite-led claim, OTP, access requests, audit).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  GUIDE
  OPERATOR
  ADMIN
  ACCOUNTANT
}

enum AccountState {
  INVITED // code issued, not yet claimed
  PENDING // self-requested, awaiting operator approval
  ACTIVE // can log in
  SUSPENDED // access revoked without deleting the record
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  passwordHash   String? // null until the account is claimed
  role           Role         @default(GUIDE)
  state          AccountState @default(INVITED)
  displayName    String // nickname shown on the roster
  fullName       String?
  guideId        String?      @unique // G-001..G-025; null for operator/admin
  phone          String?
  languages      String[]     @default([])
  qualifications String[]     @default([]) // tour ids the guide can run
  offerBlocked   Boolean      @default(false) // operator blocked this guide from receiving job offers
  // A one-off guide an operator recorded after they stepped in for someone (a
  // "ขาจร" guide, e.g. replacing a guide who fell sick mid-tour). No login, never
  // offered work: kept only so the job, its payment and PEAK carry a real person.
  external       Boolean      @default(false)
  consentAt      DateTime? // acknowledged handling customer booking data
  claimedAt      DateTime?
  createdAt      DateTime     @default(now())
  lastSeenAt     DateTime? // presence — updated while the app is open (online/offline)

  lineId            String? // LINE id/handle the guide typed (reference)
  lineUserId        String? @unique // real LINE Messaging API user id (captured on link)
  lineLinkCode      String? // one-time code to link their LINE to this account
  emergencyName     String?
  emergencyPhone    String?
  emergencyRelation String?
  licenseNo         String? // tour-guide licence no. (manual) — printed on the job order
  // Stable PEAK Contact (supplier) mapping. The ID is the identity — never resolve
  // a guide to a PEAK contact by display name at sync time, or a renamed nickname
  // silently creates a second supplier and splits their ledger.
  peakContactId     String?
  peakContactCode   String?
  peakContactName   String? // snapshot of the name in PEAK, for display/mismatch checks
  signature         String? // AES-encrypted PNG data-URI of the guide's signature
  // Verified profile (sensitive PII — stored AES-encrypted via lib/crypto).
  taxId             String?
  idCardAddress     String?
  currentAddress    String?
  bankName          String?
  bankAccountNo     String?
  bankAccountName   String?
  bankBranch        String?

  // Historical backlog: a guide can be the confirmed guide on many reviews, and an
  // operator the reviewer on many. Two named relations because User is referenced twice.
  historicalReviewsGuide    HistoricalJobReview[] @relation("HistReviewGuide")
  historicalReviewsReviewed HistoricalJobReview[] @relation("HistReviewReviewer")
  availability              Availability[]
  assignments               Assignment[]
  invites                   Invite[]
  otps                      Otp[]
  refreshTokens             RefreshToken[]
  passwordResets            PasswordReset[]
  documents                 GuideDocument[]
  notifications             Notification[]
}

// Company-wide whole-day blackout (holiday / closed day). Blocks all availability
// and assignments on that date.
model BlockedDate {
  id          String   @id @default(cuid())
  date        String   @unique // YYYY-MM-DD
  reason      String?
  createdById String?
  createdAt   DateTime @default(now())
}

// Operator blocks a single time slot on a date (no guide can be offered/assigned
// it). Finer-grained than BlockedDate, which blocks the whole day.
model BlockedSlot {
  id          String   @id @default(cuid())
  date        String // YYYY-MM-DD
  slotIdx     Int
  reason      String?
  createdById String?
  createdAt   DateTime @default(now())

  @@unique([date, slotIdx])
  @@index([date])
}

// In-app notification for a guide (e.g. operator blocked a date they were free).
model Notification {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  message   String
  kind      String    @default("info")
  offerId   String? // job-offer notifications are auto-cleared when the offer resolves
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([offerId])
}

// Uploaded reference documents (ID card, bank book). Bytes stored AES-encrypted.
model GuideDocument {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  kind       String // ID_CARD | BANK_BOOK
  filename   String
  mimeType   String
  size       Int
  data       Bytes // encrypted
  uploadedAt DateTime @default(now())

  @@index([userId])
}

model Tour {
  id   String @id // T-001..T-009
  name String
  time String

  // Operator-maintained tour info, shown to assigned guides.
  meetingPoint   String?
  meetingLat     Float?
  meetingLng     Float?
  meetingRadiusM Int? // geofence radius for check-in (default 150m if coords set)
  itinerary      String?
  included       String?
  bring          String?
  durationMin    Int? // default tour length (prefills offer duration)

  historicalReviews HistoricalJobReview[]
  assignments       Assignment[]
}

model Availability {
  id      String    @id @default(cuid())
  guideId String
  guide   User      @relation(fields: [guideId], references: [guideId], onDelete: Cascade)
  date    String // "YYYY-MM-DD"
  slots   Boolean[]

  updatedAt DateTime @updatedAt

  @@unique([guideId, date])
  @@index([date])
}

model Assignment {
  id      String  @id @default(cuid())
  guideId String
  guide   User    @relation(fields: [guideId], references: [guideId], onDelete: Cascade)
  date    String
  slotIdx Int
  tourId  String
  tour    Tour    @relation(fields: [tourId], references: [id])
  pax     Int?
  note    String?

  googleEventId    String? // guide's Google Calendar event id (for patch/delete)
  opsGoogleEventId String? // operator master-calendar event id

  createdAt DateTime @default(now())

  @@unique([guideId, date, slotIdx])
  @@index([date])
}

// A guide's (or operator's) connected Google Calendar — refresh token stored
// AES-encrypted. Lets the app create/update/delete tour events automatically.
model GoogleCalendar {
  id           String   @id @default(cuid())
  userId       String   @unique
  refreshToken String // encrypted (lib/crypto)
  calendarId   String   @default("primary")
  email        String?
  connectedAt  DateTime @default(now())
}

// Single-use, expiring invite. Code shown to the user is `selector-secret`;
// `selector` is the indexed lookup, `secretHash` is the bcrypt of the secret.
model Invite {
  id          String    @id @default(cuid())
  selector    String    @unique
  secretHash  String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  role        Role
  channel     String    @default("email")
  sentTo      String? // masked destination, for display
  expiresAt   DateTime
  usedAt      DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  @@index([userId])
}

// One-time code for claim identity verification. Short-lived, rate-limited.
model Otp {
  id         String    @id @default(cuid())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  purpose    String    @default("CLAIM_VERIFY")
  codeHash   String
  channel    String    @default("email")
  sentTo     String?
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  lastSentAt DateTime  @default(now())
  createdAt  DateTime  @default(now())

  @@index([userId])
}

enum RequestState {
  PENDING
  APPROVED
  REJECTED
}

// Self-service "request access" queue. Kept separate from User so an unverified
// stranger never gets a User row until an operator links them to a guide record.
model AccessRequest {
  id              String       @id @default(cuid())
  name            String // full name
  nickname        String? // shown to operators on the roster
  passwordHash    String? // self-set at sign-up; copied onto the guide account on approval
  phone           String?
  email           String
  believedGuideId String?
  state           RequestState @default(PENDING)
  linkedUserId    String?
  reviewedById    String?
  reviewedAt      DateTime?
  note            String?
  createdAt       DateTime     @default(now())

  @@index([state])
}

// "Remember me" persistent session. Opaque token, only its SHA-256 hash is stored.
// Rotated on every use; `family` ties a rotation chain so reuse can revoke the lot.
model RefreshToken {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String    @unique
  family    String
  userAgent String?
  expiresAt DateTime
  rotatedAt DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([family])
}

// Single-use, time-limited password reset. Only the token hash is stored.
model PasswordReset {
  id         String    @id @default(cuid())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorRole  String?
  action     String // invite.issued | invite.claimed | otp.sent | request.created | ...
  entityType String?
  entityId   String?
  detail     Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([action, createdAt]) // action-filtered "last X" lookups (health, sync throttle)
}

// A job offered to the available guides. Broadcast to everyone marked available
// for the slot; first to Accept wins (atomic). Expires + alerts the operator if
// nobody accepts in time. status: OPEN | ASSIGNED | EXPIRED | CANCELLED.
model JobOffer {
  id              String   @id @default(cuid())
  tourId          String
  date            String // "YYYY-MM-DD"
  slotIdx         Int
  durationMin     Int? // how long the tour runs, so the guide sees when it ends
  pax             Int?
  note            String?
  status          String   @default("OPEN")
  assignedGuideId String?
  expiresAt       DateTime
  createdById     String?
  createdAt       DateTime @default(now())

  responses JobOfferResponse[]

  @@index([status])
  @@index([date])
}

// A booking imported from a channel (Bokun webhook → GYG/Viator) or added by
// hand. Gathered in the Bookings Inbox, grouped by date+tour+slot, then turned
// into a job offer. `raw` keeps the full payload so parsing can be refined.
model Booking {
  id                          String                       @id @default(cuid())
  source                      String                       @default("bokun") // bokun | gyg | viator | manual
  externalId                  String? // Bokun booking id
  confirmationCode            String? // Bokun confirmation code
  externalRef                 String? // original OTA booking number (GetYourGuide / Viator ref)
  productName                 String?
  tourId                      String? // mapped to our Tour (null until mapped)
  date                        String? // "YYYY-MM-DD" start date
  startTime                   String? // "HH:MM"
  slotIdx                     Int? // mapped slot index
  pax                         Int?
  customerName                String?
  nationality                 String?
  email                       String?
  phone                       String?
  specialRequests             String?
  notes                       String?
  bookingDate                 String? // "YYYY-MM-DD" when the booking was made
  paymentStatus               String                       @default("unpaid") // unpaid | paid | deposit
  status                      String                       @default("PENDING") // PENDING | OFFERED | ASSIGNED | CANCELLED | IGNORED
  assignedGuideId             String? // set when an over-capacity slot is split across guides
  datePinned                  Boolean                      @default(false) // operator moved this booking's date/slot by hand (a rebooking outside the OTA) — the sync must NOT drag it back to the channel's date
  raw                         Json?
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  noShow                      Boolean                      @default(false) // any guest on this booking didn't arrive (kept in sync: noShowPax > 0)
  noShowPax                   Int                          @default(0) // how many of this booking's `pax` didn't arrive (0..pax) — supports partial no-shows (e.g. booked 8, came 5 → 3)
  cancelledAtSource           DateTime? // when the CHANNEL cancelled it (Bokun cancellationDate) — the source's own time, never when FolkOPS received it. Null = not cancelled, or the channel gave no time
  historicalJobReviewBookings HistoricalJobReviewBooking[]

  @@unique([source, externalId])
  @@index([date])
  @@index([status])
}

// Web Push subscription (one per browser/device) for home-screen job alerts.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
}

// Learned mapping: a channel product name → our Tour. Set the first time an
// operator maps a booking's product; future bookings of that product auto-map.
model ProductMap {
  id          String   @id @default(cuid())
  productKey  String   @unique // normalized product name
  productName String
  tourId      String
  updatedAt   DateTime @updatedAt
}

// The full Folkpath job sheet for one assigned job (guide × date × slot).
// Living document: the operator edits pax/costs/tickets anytime and re-saves.
// bookings / expenses / guideFee are JSON so rows can be added/removed freely.
// Which PEAK account each FolkOPS category books to. One row per category
// (folkopsCategory is unique), so a mapping is updated in place rather than
// accumulating duplicates. Both the CODE and the name are stored: the code is what
// PEAK books against, the name is a snapshot so the UI can show what was chosen
// even if the chart is re-fetched later. Additive table — nothing existing reads it
// yet, and an empty table simply means "chart not configured".
model PeakAccountMapping {
  id              String   @id @default(cuid())
  folkopsCategory String   @unique // GUIDE_FEE | ENTRANCE_TICKET | TRANSPORTATION | MEAL_REFRESHMENT | OTHER_TOUR_COST | REVIEW_REWARD
  // PEAK's /DailyJournals/accountcode returns { code, name, nameEn } and no id, so
  // this is reserved and stays null until PEAK exposes one. Never invent a value.
  peakAccountId   String?
  peakAccountCode String? // null = not mapped; a mapping without a code does not count
  peakAccountName String? // display snapshot of the account name in PEAK
  isActive        Boolean  @default(true)
  updatedById     String? // operator who last changed it
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Where a job sheet came from. NORMAL is every sheet that existed before the
// historical backlog: the default preserves their behaviour exactly, and a
// non-null enum keeps the PEAK check total rather than three-valued.
enum JobSheetOrigin {
  NORMAL
  HISTORICAL_BACKFILL
}

// The operator-controlled lifecycle of one historical tour instance under review.
// Nothing here is inferred: the system never sets CONFIRMED_OPERATED,
// CONFIRMED_CANCELLED or CUSTOMER_NO_SHOW on its own.
enum HistoricalReviewStatus {
  NEEDS_REVIEW
  CONFIRMED_OPERATED
  CONFIRMED_CANCELLED
  CUSTOMER_NO_SHOW
  GUIDE_UNKNOWN
  NEEDS_EVIDENCE
  READY_TO_RECONSTRUCT
  RECONSTRUCTED_DRAFT
  EXCLUDED
  COMPLETED
}

// One tour instance that has NO job sheet and needs an operator to say what
// happened. Instances that already have a sheet never get a row here — the
// backlog is a list of what is missing, and normal sheets stay outside this
// lifecycle entirely.
model HistoricalJobReview {
  id String @id @default(cuid())

  // "YYYY-MM-DD#NN" — the tour date and zero-padded slot. Deliberately excludes
  // tourId, which is MUTABLE (product mapping assigns it after import): a key
  // containing it would create a second row the first time a product was mapped.
  instanceKey String @unique
  date        String
  slotIdx     Int

  // Snapshots because a Tour can be deleted (api/tours deletes outright) and the
  // evidence must survive it.
  tourId           String?
  tour             Tour?   @relation(fields: [tourId], references: [id], onDelete: SetNull)
  tourIdSnapshot   String?
  tourNameSnapshot String?

  reviewStatus HistoricalReviewStatus @default(NEEDS_REVIEW)

  // Chosen by an operator, never inferred. SetNull keeps the review when a guide
  // account is deleted; the snapshot preserves who was named.
  confirmedGuideId       String?
  confirmedGuide         User?   @relation("HistReviewGuide", fields: [confirmedGuideId], references: [guideId], onDelete: SetNull)
  confirmedGuideSnapshot String?

  // Restrict, not SetNull: a reconstructed draft must not be swept away by the
  // generic cleanup paths that delete sheets by (guideId, date, slotIdx). Only
  // reconstructed sheets are ever linked here, so normal sheets are unaffected.
  jobSheetId String?   @unique
  jobSheet   JobSheet? @relation(fields: [jobSheetId], references: [id], onDelete: Restrict)

  exclusionReason String?
  reviewNotes     String?
  // Operational classification only — see HISTORICAL_AUDIT_KEYS. Never customer
  // names, contact details, bank or tax numbers, or raw imported payloads.
  auditSnapshot   Json?

  reviewedById String?
  reviewedBy   User?     @relation("HistReviewReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt   DateTime?

  bookings  HistoricalJobReviewBooking[]
  createdAt DateTime                     @default(now())
  updatedAt DateTime                     @updatedAt

  @@index([reviewStatus])
  @@index([date])
}

// Which imported bookings a review is based on. A real foreign key, not a string
// array — but nullable with SetNull, plus immutable snapshots, so deleting an
// imported booking cannot erase the evidence a review was built from.
model HistoricalJobReviewBooking {
  id                 String   @id @default(cuid())
  historicalReviewId String
  bookingId          String?
  bookingIdSnapshot  String
  bookingRefSnapshot String?
  linkedAt           DateTime @default(now())

  historicalReview HistoricalJobReview @relation(fields: [historicalReviewId], references: [id], onDelete: Cascade)
  booking          Booking?            @relation(fields: [bookingId], references: [id], onDelete: SetNull)

  @@unique([historicalReviewId, bookingIdSnapshot])
  @@index([bookingId])
}

// The last job number handed out per tour date (FOLK-BKK-YYYYMMDD-NN). Reserved atomically
// before a sheet is written, so two requests can never be given the same number; gaps are fine.
model JobRefCounter {
  date    String @id
  lastSeq BigInt
}

model JobSheet {
  id                 String               @id @default(cuid())
  origin             JobSheetOrigin       @default(NORMAL)
  reconstructionNote String? // written once at reconstruction; never edited
  historicalReview   HistoricalJobReview?
  ref                String? // FOLK-BKK-YYYYMMDD-NN
  guideId            String
  date               String // "YYYY-MM-DD"
  slotIdx            Int
  tourId             String
  status             String               @default("Confirmed")
  bookings           Json                 @default("[]") // [{name, bookingNo, bookedPax, actualPax, tickets, status}]
  expenses           Json                 @default("[]") // [{description, price, pax}] — operator's official set
  guideFee           Json                 @default("{}") // {price, time, whtPct}
  guideExpenses      Json? // [{description, price, pax}] — guide's own report, to cross-check
  guideExpensesAt    DateTime? // when the guide last submitted their expense report
  guideExpensesNote  String? // free-text note the guide adds with their expense report
  operatorNote       String? // free-text comment the operator adds for the guide (shown on the guide's sheet)
  // Finance/accounting approval — the operator signs off the actual expenses before
  // payout / PEAK sync. Additive + nullable: an unset value reads as "not approved".
  approvalStatus     String? // null | "APPROVED" (lifecycle grows later: DRAFT → READY_FOR_REVIEW → APPROVED)
  approvedBy         String? // User.id of the operator who approved
  approvedAt         DateTime?
  // First successful operator save — the certification date printed under the
  // authorized signature on the sheet/PDF. Stamped once server-side (only while
  // NULL); later saves touch updatedAt but never this. Historical sheets stay
  // NULL until their next save (display falls back to approvedAt — lib/certifier).
  certifiedAt        DateTime?
  // ── Accounting dates ──────────────────────────────────────────────────────
  // Both default to the TOUR date (see lib/peak-sync.defaultAccountingDates), so a
  // document never lands in the period someone happened to press Sync in.
  // paymentDate is the ACTUAL transfer date and is set when the payout is made.
  accountingDate     String? // "YYYY-MM-DD" — the period this job books into
  documentDate       String? // "YYYY-MM-DD" — the PEAK document date
  paymentDate        String? // "YYYY-MM-DD" — when the guide was actually paid
  // ── PEAK sync state ───────────────────────────────────────────────────────
  // NOT_READY | READY | SYNCING | SYNCED | FAILED | BLOCKED. Null = never attempted.
  peakSyncStatus     String?
  peakDocumentId     String? // PEAK's internal id for the created expense
  peakDocumentNo     String? // the EXP-… number shown to humans
  syncedAt           DateTime?
  syncError          String? // last failure, sanitised — never contains credentials
  // Fingerprint of the payload at the last successful sync. Re-posting an unchanged
  // sheet is refused (it would duplicate); a changed one requires an operator
  // decision rather than a silent overwrite. See lib/peak-sync.peakPayloadHash.
  lastPayloadHash    String?
  createdById        String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@unique([guideId, date, slotIdx])
  @@index([date])
}

// Tour lifecycle proof-of-work: a guide's check-in / start / complete events for
// an assignment, with the GPS captured at the moment (geofencing comes once
// meeting points carry coordinates).
model Checkin {
  id             String   @id @default(cuid())
  guideId        String
  date           String // "YYYY-MM-DD"
  slotIdx        Int
  tourId         String
  type           String // ARRIVE | START | COMPLETE
  at             DateTime @default(now())
  lat            Float?
  lng            Float?
  accuracyM      Int?
  distanceM      Int? // metres from the meeting point (if it has coords)
  withinGeofence Boolean?

  // Who recorded this. NULL = the guide, from their own phone, with GPS — every
  // row that exists today. Set only when an OPERATOR records it on the guide's
  // behalf, which has no location proof behind it and must never be mistaken for
  // the guide having been there.
  recordedById   String?
  recordedByRole String?

  @@index([guideId, date, slotIdx])
  @@index([date])
}

// A tour handed from one guide to another part-way through (the first guide fell
// sick, was injured…). Both guides keep their own assignment and job sheet: the
// guests, no-shows and end-of-tour report stay with the original guide's sheet,
// the guide fee moves to the replacement (owner decision 2026-09-15). The row is
// the record of who handed over to whom, when and why; it is never deleted — an
// undo stamps revokedAt.
model TourHandover {
  id           String    @id @default(cuid())
  date         String // "YYYY-MM-DD"
  slotIdx      Int
  tourId       String
  fromGuideId  String
  toGuideId    String
  handedOverAt String // "HH:MM" Bangkok, as the operator recorded it
  reason       String // SICK | INJURY | OTHER
  note         String? // internal — operators only, never shown to a guide
  fromFee      Json? // the original guide's fee before the handover, restored on undo
  createdById  String?
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?
  revokedById  String?

  @@index([date, slotIdx])
  @@index([fromGuideId])
  @@index([toGuideId])
}

// End-of-tour report: what actually happened. Attendance (booked/arrived/left
// early/no-show) + incidents. Recorded for quality & dispute protection; does NOT
// change the guide's fee or reimbursements (work done + costs already incurred).
model TourReport {
  id           String   @id @default(cuid())
  guideId      String
  date         String // "YYYY-MM-DD"
  slotIdx      Int
  tourId       String
  bookedPax    Int?
  noShow       Int      @default(0)
  leftEarly    Int      @default(0)
  completedPax Int?
  comments     String?
  submittedAt  DateTime @default(now())

  @@unique([guideId, date, slotIdx])
  @@index([date])
}

// Per-tour payment state (Pending → Approved → Paid). The amount is computed
// live from the job sheet (net fee + reimbursements); this just tracks the state.
model TourPayment {
  id             String    @id @default(cuid())
  guideId        String
  date           String // "YYYY-MM-DD"
  slotIdx        Int
  tourId         String
  status         String    @default("PENDING") // PENDING | APPROVED | PAID
  approvedBy     String?
  approvedAt     DateTime?
  paidAt         DateTime?
  peakRef        String? // PEAK expense ref for THIS payment (a transfer covers a batch of tours)
  eslipUrl       String? // payment slip in Drive — one slip can cover a merged batch of tours
  slips          Json? // split payment: [{ amount, url, at, name? }] — several transfers that sum to this tour's payout; eslipUrl mirrors the latest for back-compat
  paidBatchNo    String? // FP-BATCH-… that settled this tour — provenance, so un-marking a batch only reverts ITS tours
  // The combined PEAK payment document this tour was paid in ("Pay N jobs together").
  // Set when the payment is CLAIMED, before PEAK is called, so a second click or a
  // job-sheet sync cannot book the same cost again. Every tour in one transfer shares
  // the same ref and document id. Cleared only when PEAK definitely refused the post.
  peakPaymentRef String? // FOLK-PAY-YYYYMM-NN → GuidePaymentDocument.paymentRef
  peakDocumentId String? // PEAK's internal id for that document (peakRef holds its EXP-… number)
  // CACHE / BACK-POINTER ONLY — never the authority.
  //
  // GuidePaymentJob (with active = true) owns the fact "this job is paid by this payment";
  // the database enforces one active payment per job there. This column only lets a reader
  // that already holds the TourPayment row tell a v2 payment from a legacy one without a
  // join, and it is written and cleared in the same transaction as that row.
  //
  // It must NEVER decide on its own whether a job is actively paid: ask GuidePaymentJob.
  // If the two disagree, GuidePaymentJob wins. Null on unpaid jobs and on rows paid before
  // Payments v2 (legacy), which read as "paid · no payment record".
  guidePaymentId String?
  updatedAt      DateTime  @updatedAt

  @@unique([guideId, date, slotIdx])
  @@index([guideId])
  @@index([status])
  @@index([peakPaymentRef])
  @@index([guidePaymentId])
}

// One PEAK expense document that pays several of a guide's tours in one transfer:
// one contact, one payment reference, one payment date, one Paid By account, one slip,
// and a line per job and category. The row is written BEFORE the PEAK call and is the
// lock and the audit trail — see lib/peak-payment-document.
// ── Payments v2 ─────────────────────────────────────────────────────────────────
// An actual guide payment: one bank transfer (FOLK-PMT-YYYYMM-NNN). It is the ONLY thing
// that makes a job PAID. It never replaces the Job No. (FOLK-BKK-…) as the job's reference
// nor the PEAK document (EXP-…) as its accounting record: it links jobs, the transfer and
// its evidence. Written only by lib/payments-v2 (recordPayment / reversePayment). Never
// deleted — a mistaken payment is REVERSED, with a reason, and stays on record.
model GuidePayment {
  id                   String    @id @default(cuid())
  paymentNo            String    @unique // FOLK-PMT-YYYYMM-NNN — month of the payment date
  guideId              String
  accountingPeriod     String // "YYYY-MM" the jobs book into (their tour month)
  paymentDate          String // "YYYY-MM-DD" (Bangkok) the money actually left the bank — the WHT date
  jobTotal             Decimal   @db.Decimal(12, 2) // Σ job payable at payment time
  adjustmentTotal      Decimal   @db.Decimal(12, 2) // Σ signed adjustments
  amountTransferred    Decimal   @db.Decimal(12, 2) // what the bank sent
  status               String    @default("RECORDED") // RECORDED | REVERSED
  source               String    @default("MANUAL") // MANUAL | BANK_SLIP_MATCH | SLIP_REVIEW | PEAK_DOCUMENT
  bankRef              String? // bank transaction / reference number, when known
  evidenceId           String? // PaymentEvidence holding the slip
  slipUrl              String? // Drive link to the slip
  slipUploadedAt       DateTime?
  slipUploadedById     String?
  noSlipReason         String? // required when there is no slip
  mismatchReason       String? // required when jobs + adjustments ≠ amount transferred
  periodOverrideReason String? // required when the jobs span more than one accounting month
  peakPaymentRef       String? // FOLK-PAY-… when paid through a combined PEAK document
  note                 String?
  createdById          String?
  createdAt            DateTime  @default(now())
  reversedAt           DateTime?
  reversedById         String?
  reversalReason       String?

  jobs        GuidePaymentJob[]
  adjustments GuidePaymentAdjustment[]

  @@index([guideId, accountingPeriod])
  @@index([paymentDate])
  @@index([status])
  @@index([bankRef])
}

// One job in a payment, with the figures it was paid on. The Job No. is copied in full.
// `active` turns false when the payment is reversed; a partial unique index (migration
// SQL) allows only ONE active payment per job — the database refuses a double payment.
model GuidePaymentJob {
  id             String       @id @default(cuid())
  payment        GuidePayment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  paymentId      String
  guideId        String
  date           String // "YYYY-MM-DD" tour date
  slotIdx        Int
  jobNo          String // full FOLK-BKK-YYYYMMDD-NN at payment time
  accountingDate String // "YYYY-MM-DD" the job books into
  feeGross       Decimal      @db.Decimal(12, 2)
  wht            Decimal      @db.Decimal(12, 2)
  reimbursement  Decimal      @db.Decimal(12, 2)
  reviewReward   Decimal      @db.Decimal(12, 2)
  payable        Decimal      @db.Decimal(12, 2)
  peakDocumentNo String? // the PEAK document the job explicitly belonged to when paid — never inferred
  peakDocumentId String?
  peakSource     String? // sheet | combined | payment | payroll
  active         Boolean      @default(true)
  createdAt      DateTime     @default(now())

  @@index([guideId, date, slotIdx])
  @@index([paymentId])
  @@index([jobNo])
}

// A signed line that reconciles job payable to the transfer: −70 settles an advance
// balance the guide still holds. It is NOT an expense and never changes a job's figures.
model GuidePaymentAdjustment {
  id              String        @id @default(cuid())
  payment         GuidePayment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  paymentId       String
  type            String // ADVANCE_SETTLEMENT | PREVIOUS_OVERPAYMENT | PREVIOUS_UNDERPAYMENT | MANUAL_CORRECTION | OTHER
  amount          Decimal       @db.Decimal(12, 2) // signed
  description     String
  jobNo           String? // the job it relates to, when it relates to one
  advanceReturnId String? // unused — a Phase 1 placeholder aimed at the wrong object; the link below is the real one
  // Phase 3: the advance this settlement clears. Required for new ADVANCE_SETTLEMENT
  // rows; the ledger entry beside it is what actually moves the balance.
  advance         GuideAdvance? @relation(fields: [advanceId], references: [id], onDelete: Restrict)
  advanceId       String?
  createdById     String?
  createdAt       DateTime      @default(now())

  @@index([paymentId])
  // GuidePaymentAdjustment_advanceId_idx, created in 20260917100000_guide_advance_ledger.
  @@index([advanceId])
}

model GuidePaymentDocument {
  id                String    @id @default(cuid())
  paymentRef        String    @unique // FOLK-PAY-YYYYMM-NN — sent to PEAK as the document reference
  guideId           String
  paymentDate       String? // "YYYY-MM-DD" — set when the payment is recorded (stage 2)
  paymentMethodId   String? // PEAK payment method (the Paid By account) — set at stage 2
  paymentMethodName String? // display only
  jobs              Json // [{ date, slotIdx, ref, payout }] exactly as claimed
  lines             Json // the line trace exactly as posted (job, kind, category, account, amount, wht)
  total             Float // net due — the amount the transfer must be
  // Jobs that were ALREADY PAID (a transfer made before any PEAK document existed) put
  // into one PEAK document afterwards. Recording the payment then only adds the EXP to
  // the jobs; voiding releases the EXP and never makes a paid job unpaid again.
  alreadyPaid       Boolean   @default(false)
  // Stage 1 — the expense document (lib/peak-payment-document):
  //   CREATING          claimed, PEAK not yet answered
  //   CREATE_UNCERTAIN  PEAK did not answer — the document may exist; jobs stay locked until a person checks PEAK
  //   FAILED            PEAK definitely refused the document; jobs released
  //   AWAITING_PAYMENT  the EXP exists in PEAK, unpaid; jobs locked to it, not paid
  // Stage 2 — the payment against that same EXP:
  //   PAYING            payment claimed, PEAK not yet answered
  //   PAYMENT_UNCERTAIN PEAK did not answer the payment — jobs stay unpaid and locked until a person checks PEAK
  //   PAID              PEAK recorded the payment; every job is PAID
  // Either stage:
  //   VOIDED            an operator confirmed the document was voided in PEAK; jobs released (and unpaid)
  // Legacy one-step values (POSTING / POSTED / UNCERTAIN) are read as CREATING / PAID / CREATE_UNCERTAIN.
  status            String    @default("CREATING")
  error             String?
  slipUrl           String?
  // Evidence of the transfer, recorded at stage 2 before the payment is confirmed.
  // bankRef also reaches GuidePayment.bankRef, where payments-v2 refuses to record the
  // same bank reference against two transfers.
  bankRef           String? // exactly as the operator typed it, for display
  // The same reference with spacing removed and upper-cased. This is what is compared
  // and what must be unique: banks print one reference several ways and people retype
  // it in several cases, and those are one transfer, not two.
  bankRefNormalized String?
  // WHICH BANK ACCOUNT the money left from, as one comparable string — the PEAK payment
  // method's account number reduced to digits (`ACC:…`), or its channel id when PEAK
  // gives no account (`PM:…`). A payment method is a channel, not an account: two
  // channels can name the same account, and a bank reference is unique within a BANK.
  bankAccountKey    String?
  slipAmount        Float? // the amount printed on the slip, as the operator read it
  slipUploadedAt    DateTime?
  // Who says the amount and the reference match the slip, and when. There is no OCR:
  // a person read the slip, and the record says so (USER_VERIFIED_SLIP).
  slipVerifiedById  String?
  slipVerifiedAt    DateTime?
  verificationSource String?
  peakDocumentId    String?
  peakDocumentNo    String? // EXP-…
  peakDocumentLink  String?
  peakDocumentStatus String? // what PEAK last said about it (open / paid / voided …)
  peakPostedAt      DateTime? // when PEAK accepted the document — not when the row was made
  // Fingerprint of the payload PEAK was given (lib/payment-transfer paymentPayloadHash).
  // A payload that no longer hashes the same is drift the figure comparison may not model.
  peakPayloadHash   String?
  attachmentStatus  String? // ATTACHED | FAILED — the slip on the PEAK document; never affects paid state
  attachmentError   String?
  createdById       String?
  resolvedById      String?
  resolvedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@index([guideId])
  @@index([status])
  @@index([bankRef])
  @@index([bankRefNormalized])
  // One bank reference settles one document, per BANK ACCOUNT the money left from —
  // reference numbers are only unique within a bank. Rows with no reference yet hold
  // NULL, which Postgres treats as distinct, so every document without one is left
  // alone. Neither column is ever written without the other (peak-payment-server), and
  // a trigger refuses to let either change once a transfer has been recorded.
  @@unique([bankAccountKey, bankRefNormalized])
}

// Guide leave (holiday / unavailable range). Operator-approved; an approved leave
// excludes the guide from job offers across the date range.
model LeaveRequest {
  id        String    @id @default(cuid())
  guideId   String
  fromDate  String // "YYYY-MM-DD"
  toDate    String // "YYYY-MM-DD"
  reason    String?
  status    String    @default("PENDING") // PENDING | APPROVED | REJECTED
  decidedBy String?
  decidedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([guideId])
  @@index([status])
}

// Operator's rating of a guide for a tour (1–5). Feeds the guide directory.
model GuideRating {
  id        String   @id @default(cuid())
  guideId   String
  date      String
  slotIdx   Int
  tourId    String
  stars     Int // 1..5
  note      String?
  ratedBy   String?
  createdAt DateTime @default(now())

  @@unique([guideId, date, slotIdx])
  @@index([guideId])
}

// WebAuthn passkey — true Face ID / fingerprint sign-in (one per device).
model Passkey {
  id           String   @id @default(cuid())
  credentialId String   @unique // base64url
  publicKey    String // base64url
  counter      Int      @default(0)
  userId       String
  transports   String? // csv
  label        String?
  createdAt    DateTime @default(now())

  @@index([userId])
}

// Payroll paid/pending marker per guide per month. The amounts are computed live
// from job sheets; this just records what's been settled.
model PayrollStatus {
  id        String    @id @default(cuid())
  guideId   String
  period    String // "YYYY-MM"
  status    String    @default("pending") // pending | paid
  paidAt    DateTime?
  eslipUrl  String? // Google Drive link to the uploaded bank payment slip (evidence)
  peakRef   String? // PEAK accounting expense ref (e.g. EXP-xxxxxxx) for the combined payout
  note      String?
  updatedAt DateTime  @updatedAt

  @@unique([guideId, period])
}

// One row per guide the offer touched: OFFERED when sent, then ACCEPTED/DENIED.
model JobOfferResponse {
  id          String   @id @default(cuid())
  offer       JobOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  offerId     String
  guideId     String
  response    String   @default("OFFERED") // OFFERED | ACCEPTED | DENIED
  respondedAt DateTime @default(now())

  @@unique([offerId, guideId])
  @@index([offerId])
}

// Someone who added the LINE Official Account but isn't yet linked to a guide
// account. Captured from the webhook (follow / message) with their LINE display
// name + photo so an operator can match them to a guide in one click — instead of
// the guide having to send a code. `linkedUserId` is set once matched (kept for a
// short audit trail; the live link lives on User.lineUserId).
model LineContact {
  id           String   @id @default(cuid())
  lineUserId   String   @unique
  displayName  String?
  pictureUrl   String?
  linkedUserId String? // User.id once an operator matched this follower to a guide
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([linkedUserId])
}

// Money transferred to a guide BEFORE a tour so they can pay tickets/transport on
// the day. An advance is a CASH MOVEMENT, never an expense: the actual spend stays
// in JobSheet.expenses (rows with paidBy = "advance"), and unused money comes back
// as GuideAdvanceReturn rows. Settlement math lives in lib/advance (pure, tested):
//   outstanding = advances − advance-paid expenses − returns.
// Keyed by the house job tuple (guideId + date + slotIdx), like TourPayment.
model GuideAdvance {
  id          String   @id @default(cuid())
  guideId     String
  date        String // "YYYY-MM-DD"
  slotIdx     Int
  amount      Float
  paidAt      DateTime
  method      String   @default("bank") // bank | cash | other
  bankAccount String? // explicitly selected PEAK bank subaccount ID
  txRef       String? // bank transaction reference
  peakRef     String? // PEAK expense/advance ref once posted (future PEAK sync)
  slipUrl     String? // Drive link to the transfer slip (evidence)
  slipFileId  String?
  note        String?
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // ── Phase 3 ledger ────────────────────────────────────────────────────────
  // The columns above stay exactly as they were (legacy read paths still use
  // them). These are the ledger's own: money in satang, a running settled total
  // the DATABASE bounds, and the dates kept apart — advanceDate is when the bank
  // moved it, createdAt is when someone typed it.
  advanceNo        String    @unique // FOLK-ADV-YYYYMM-NNN
  jobNo            String? // the Job No. it was issued for, when it was
  advanceDate      String // "YYYY-MM-DD" (Bangkok) the money left the bank
  amountSatang     Int // > 0
  settledSatang    Int       @default(0) // Σ entries; 0 <= settled <= amountSatang (CHECK)
  purpose          String?
  evidenceId       String?
  accountingPeriod String // "YYYY-MM"
  peakDocumentNo   String? // recorded, never inferred
  peakReference    String?
  reversedAt       DateTime?
  reversedById     String?
  reversalReason   String?

  returns     GuideAdvanceReturn[]
  entries     GuideAdvanceEntry[]
  adjustments GuidePaymentAdjustment[]

  @@index([guideId, date, slotIdx])
  @@index([date])
  @@index([guideId, advanceDate])
  @@index([accountingPeriod])
}

// Money coming BACK from a guide: one real incoming transfer, exactly like
// GuidePayment is one real outgoing one. It is allocated to advances by
// GuideAdvanceEntry rows — one receipt can clear several advances.
//
// A guide can only ever CLAIM one (from the app); it settles nothing until an
// operator has seen the money in the bank and VERIFIED it. That is why
// allocatedSatang is forced to 0 unless the status is VERIFIED (CHECK).
model GuideAdvanceReceipt {
  id              String    @id @default(cuid())
  receiptNo       String    @unique // FOLK-ADR-YYYYMM-NNN
  guideId         String
  receivedDate    String // "YYYY-MM-DD" (Bangkok) the money reached the company
  amountSatang    Int // > 0
  allocatedSatang Int       @default(0) // Σ RETURN_ALLOCATION entries; 0 <= allocated <= amountSatang
  status          String    @default("CLAIMED") // CLAIMED | VERIFIED | REJECTED
  method          String    @default("bank")
  bankAccount     String?
  bankRef         String?
  evidenceId      String?
  slipUrl         String?
  slipFileId      String?
  note            String?
  claimedById     String?
  claimedAt       DateTime?
  verifiedById    String?
  verifiedAt      DateTime?
  rejectedReason  String?
  legacyReturnId  String?   @unique // the GuideAdvanceReturn row this came from
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // An existing PEAK document, when the accountant had already recorded this return
  // by hand. Recorded, never inferred — the same rule the advance and the ledger use.
  peakDocumentNo String?
  peakReference  String?

  entries GuideAdvanceEntry[]

  @@index([guideId, status])
  @@index([receivedDate])
}

// Every movement that changes an advance balance. Append-only: written once,
// never edited, never deleted. A correction that lowers the settled amount is a
// REVERSAL of the entry that was wrong, not a negative entry — which is what
// makes "a reversal can never be refused" true (see lib/advances/rules).
//
// Signs: every type except REVERSAL is strictly positive (it settles); a REVERSAL
// is exactly the negative of the entry it reverses. Both enforced by CHECK.
model GuideAdvanceEntry {
  id                String               @id @default(cuid())
  advance           GuideAdvance         @relation(fields: [advanceId], references: [id], onDelete: Restrict)
  advanceId         String
  type              String // EXPENSE_SETTLEMENT | RETURN_ALLOCATION | PAYMENT_DEDUCTION | CORRECTION | REVERSAL
  amountSatang      Int // signed
  effectiveDate     String // "YYYY-MM-DD" the movement took effect
  accountingPeriod  String // "YYYY-MM"
  sourceType        String // JOB_SHEET | RECEIPT | PAYMENT | MANUAL | REVERSAL
  sourceId          String // jobSheetId | receiptId | guidePaymentId | the reversed entry id | a manual key
  jobNo             String?
  snapshot          Json? // what an EXPENSE_SETTLEMENT covered, as it was then
  receipt           GuideAdvanceReceipt? @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  receiptId         String?
  paymentId         String? // GuidePayment.id for PAYMENT_DEDUCTION
  // Both directions are real foreign keys in the database (20260917100000_guide_advance_ledger:
  // GuideAdvanceEntry_reversesEntryId_fkey and GuideAdvanceEntry_reversedByEntryId_fkey, each
  // REFERENCES "GuideAdvanceEntry"("id") ON DELETE RESTRICT ON UPDATE CASCADE). Prisma
  // declared only the first, so the second was invisible here and would have been offered
  // for deletion by the next `prisma migrate dev`.
  //
  // A REVERSAL points back at what it reverses; the entry it reverses points forward at it.
  // The pair is what `GuideAdvanceEntry_one_live_per_source` reads to free a source's slot.
  reverses          GuideAdvanceEntry?   @relation("EntryReverses", fields: [reversesEntryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reversesEntryId   String?              @unique
  /** The entry that reverses this one — the other side of `reverses`. No column. */
  reversedByEntry   GuideAdvanceEntry?   @relation("EntryReverses")
  reversedBy        GuideAdvanceEntry?   @relation("EntryReversedBy", fields: [reversedByEntryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  reversedByEntryId String?              @unique // set on the target when it is reversed
  /** The entry whose `reversedByEntryId` names this one. No column. */
  reversalTargetOf  GuideAdvanceEntry?   @relation("EntryReversedBy")
  reason            String?
  requestKey        String // groups the entries written by one operator action
  idempotencyKey    String               @unique // requestKey + advanceId
  provenance        String               @default("OPERATOR") // OPERATOR | SYSTEM | MIGRATED
  peakDocumentNo    String?
  peakReference     String?
  createdById       String?
  createdAt         DateTime             @default(now())

  @@index([advanceId])
  @@index([receiptId])
  @@index([paymentId])
  @@index([requestKey])
  @@index([accountingPeriod])
}

// The guide handing unused advance money back (possibly in several transfers).
// NOT a negative expense — it only settles the advance balance.
model GuideAdvanceReturn {
  id          String        @id @default(cuid())
  advanceId   String? // optional link to one advance; settlement is job-level either way
  advance     GuideAdvance? @relation(fields: [advanceId], references: [id], onDelete: SetNull)
  guideId     String
  date        String // "YYYY-MM-DD" — the JOB's date (house tuple), not the transfer date
  slotIdx     Int
  amount      Float
  returnedAt  DateTime
  method      String        @default("bank")
  txRef       String?
  slipUrl     String? // Drive link to the guide's return-transfer slip
  slipFileId  String?
  note        String?
  createdById String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([guideId, date, slotIdx])
  @@index([date])
}

// Ad-hoc bonus / adjustment paid to a guide in a month (e.g. a 5-star review reward).
// Tracked separately from tour pay; shown in the Payments "Bonuses" panel.
model Bonus {
  id          String   @id @default(cuid())
  guideId     String
  period      String // "YYYY-MM"
  amount      Float
  ref         String? // distinct bonus reference (own no., e.g. for PEAK) — not the job sheet ref
  reason      String?
  eslipUrl    String? // Google Drive link to the bonus payment slip (evidence)
  createdById String?
  createdAt   DateTime @default(now())

  @@index([period])
}

// ─────────────────────────────────────────────────────────────────────────────
// Payment architecture — Phase 2: bank-slip evidence + the transaction extracted
// from it. Additive: the existing TourPayment / PayrollStatus flow is untouched.
// Money uses Decimal and payment times use timestamptz for financial correctness.
// Idempotency: unique googleDriveFileId + fileHash (a slip can't be recorded
// twice), and a unique nullable transactionId (one bank transaction = one record;
// Postgres allows multiple NULLs, giving the "unique where not null" behaviour).
// ─────────────────────────────────────────────────────────────────────────────

// The original bank slip (or other payment evidence) stored privately in Drive.
model PaymentEvidence {
  id              String  @id @default(cuid())
  guideId         String? // the guide this slip pays (matched via the extracted reference)
  payrollPeriod   String? // "YYYY-MM" when tied to the existing monthly payroll
  evidenceType    String  @default("K_BIZ_SLIP") // K_BIZ_SLIP | KCASH_RESULT | BANK_STATEMENT | MANUAL | OTHER
  paymentProvider String  @default("K_BIZ_SLIP")

  googleDriveFileId   String  @unique // idempotency: a Drive file is recorded once
  googleDriveFolderId String?
  originalFilename    String?
  mimeType            String?
  fileSize            Int?
  fileHash            String  @unique // sha-256 of the bytes: same file, never twice
  driveLink           String?

  slipUploadedAt       DateTime? @db.Timestamptz(6) // when the operator uploaded it here
  slipUploadedBy       String?
  historicalImportedAt DateTime? @db.Timestamptz(6)
  driveCreatedAt       DateTime? @db.Timestamptz(6)
  driveModifiedAt      DateTime? @db.Timestamptz(6)

  extractionMethod     String? // PDF_TEXT | OCR_PDF | OCR_IMAGE | MANUAL_CORRECTION | BANK_RESULT_FILE | BANK_API | BANK_STATEMENT | OTHER
  extractionConfidence Float?
  rawText              String? // full extracted text — audit / parser improvement
  rawData              Json?
  processingStatus     String  @default("QUEUED") // QUEUED | PROCESSING | COMPLETED | NEEDS_REVIEW | FAILED | SKIPPED_DUPLICATE
  processingError      String?

  transaction PaymentTransaction?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guideId])
  @@index([processingStatus])
}

// Structured payment data parsed from a PaymentEvidence slip.
model PaymentTransaction {
  id         String          @id @default(cuid())
  evidence   PaymentEvidence @relation(fields: [evidenceId], references: [id], onDelete: Cascade)
  evidenceId String          @unique

  transactionId      String? @unique // bank transaction id — dedup (unique-where-not-null)
  transactionStatus  String?
  transactionChannel String?

  transactionDateRaw String? // original "DD/MM/YYYY HH:mm" — never overwritten
  paidAt             DateTime? @db.Timestamptz(6) // authoritative transfer time
  deductedAt         DateTime? @db.Timestamptz(6)
  receivedAt         DateTime? @db.Timestamptz(6)

  senderName             String?
  senderAccountMasked    String?
  senderBank             String?
  recipientName          String?
  recipientAccountMasked String?
  recipientBank          String?

  transferAmount Decimal? @db.Decimal(12, 2)
  transferFee    Decimal? @db.Decimal(12, 2)
  totalAmount    Decimal? @db.Decimal(12, 2)
  currency       String   @default("THB")

  paymentMemoRaw        String? // exactly as printed — never mutated
  paymentMemoNormalized String?
  paymentReferenceType  String? // JOB_NO | PAYOUT_ITEM_NO | PAYMENT_BATCH_NO | PEAK_EXPENSE_NO | OTHER | NOT_FOUND
  paymentReferenceValue String?

  detectedBank String?
  sourceType   String? // PDF_TEXT | OCR_PDF | OCR_IMAGE | ...

  // Provider-issued transaction id, kept DISTINCT from the bank `transactionId`
  // above (e.g. a K CASH CONNECT PLUS result id like KCCP-TRANSACTION-123456).
  providerTransactionId String? @unique

  // Split validation (spec): the memo/reference match is judged separately from
  // the transaction-level checks (duplicate / amount / recipient). `validationStatus`
  // below stays as the overall roll-up used by existing code.
  memoValidationStatus        String? @default("PENDING") // PENDING | MATCHED | NOT_MATCHED | REFERENCE_GUIDE_MISMATCH | AMOUNT_MISMATCH
  transactionValidationStatus String? @default("PENDING") // PENDING | OK | DUPLICATE_TRANSACTION | NEEDS_REVIEW

  // What the memo reference resolved to. Only the relevant pair is set; the *_No
  // columns hold the human reference, the *_Id columns the internal row id (linked
  // to the Payout / PaymentBatch models added with the matching engine in a later stage).
  matchedJobSheetId     String?
  matchedJobNo          String?
  matchedPayoutId       String?
  matchedPayoutItemNo   String?
  matchedPaymentBatchId String?
  matchedPaymentBatchNo String?

  // The PEAK expense created for this payment, stored separately from the bank ids
  // and the memo — never overwrite `transactionId` / `paymentReferenceValue` with it.
  peakExpenseNo String?

  // K CASH CONNECT PLUS preparation: the bank's own batch/item references and the
  // customer reference, preserved raw and separate from our Folkpaths references.
  bankBatchReference String?
  bankItemReference  String?
  customerReference  String?

  validationStatus  String @default("PENDING") // PENDING | MATCHED | PAYMENT_NEEDS_REVIEW | FAILED
  validationDetails Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([paymentReferenceType, paymentReferenceValue])
  @@index([matchedJobNo])
  @@index([matchedPayoutItemNo])
  @@index([transactionValidationStatus])
  @@index([memoValidationStatus])
}

// ─────────────────────────────────────────────────────────────────────────────
// Payment batches — group several guide tour-payouts into ONE bank run. Items are
// SNAPSHOTTED from the job sheets at add time (computeTotals, server-side), so a
// batch records what was actually settled even if a sheet is edited afterwards.
// A tour payout (guideId+date+slotIdx) belongs to at most ONE batch at a time — the
// unique on PaymentBatchItem enforces "not in two active batches"; deleting a batch
// cascade-deletes its items, freeing those payouts to be re-batched. guide.folkpaths
// stays the operational record; PEAK remains the accounting mirror.
// ─────────────────────────────────────────────────────────────────────────────
model PaymentBatch {
  id          String    @id @default(cuid())
  batchNo     String    @unique // FP-BATCH-YYYYMMDD-NN (matches the bank-slip PAYMENT_BATCH_NO format)
  status      String    @default("DRAFT") // DRAFT | READY | PROCESSING | PAID | FAILED | CANCELLED
  paymentDate String? // "YYYY-MM-DD" — when the transfer is/was made
  totalAmount Float     @default(0) // sum of item.totalPayable at build time (THB)
  note        String?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  paidAt      DateTime?

  items PaymentBatchItem[]

  @@index([status])
}

// One guide tour-payout inside a batch. Amounts are a snapshot of the job sheet's
// computeTotals at add time (net guide fee after WHT / reimbursable expenses / their
// sum), never trusted from the client. The unique key is the tour-payout tuple, so
// the same payout can't sit in two batches at once.
model PaymentBatchItem {
  id            String       @id @default(cuid())
  batch         PaymentBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  batchId       String
  guideId       String
  date          String // "YYYY-MM-DD"
  slotIdx       Int
  tourId        String       @default("")
  ref           String? // JobSheet.ref snapshot (FOLK-BKK-…), for display / slip matching
  guideFee      Float        @default(0) // net guide fee after WHT (snapshot)
  reimbursement Float        @default(0) // reimbursable expenses (snapshot)
  totalPayable  Float        @default(0) // guideFee + reimbursement (snapshot)
  paymentStatus String       @default("PENDING") // PENDING | PAID
  createdAt     DateTime     @default(now())

  @@unique([guideId, date, slotIdx]) // a payout is in at most one batch at a time
  @@index([batchId])
}

// Transactional outbox: one journal for one source event. Old rows are NOT backfilled.
model AdvancePeakSync {
  id String @id // ADVANCE:<id> | RETURN:<id> | EXPENSE:<entry id>
  kind String
  sourceId String
  status String @default("PENDING") // PENDING | BLOCKED | SENDING | UNCERTAIN | POSTED | CANCELLED
  documentId String?
  documentNo String?
  error String?
  payload Json?
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  createdAt DateTime @default(now())
  // DEFAULT CURRENT_TIMESTAMP in 20260923090000_advance_peak_outbox: a row inserted by
  // the enqueue trigger names no updatedAt, so the database has to supply one.
  updatedAt DateTime @default(now()) @updatedAt
  @@unique([kind, sourceId])
  @@index([status, nextAttemptAt])
}

// A PEAK document that already existed before FolkOPS knew about it.
//
// The outbox (AdvancePeakSync) answers "did we send this?". This answers the other
// question: "is this event already in PEAK, put there by someone else?" — which is
// the only safe reason to close an outbox item without sending anything.
//
// One row per business event (kind, sourceId), and one row per PEAK document
// (documentType, documentNo). The second key is what stops the same journal being
// attached to two different advances: PEAK numbers its documents per type, so the
// type belongs in the key.
model AdvancePeakDocumentLink {
  id           String   @id @default(cuid())
  kind         String // ADVANCE | RETURN | EXPENSE
  sourceId     String // GuideAdvance.id | GuideAdvanceReceipt.id | GuideAdvanceEntry.id
  documentType String // DAILY_JOURNAL | EXPENSE
  documentNo   String
  documentId   String? // PEAK's own id, when the read-only lookup returned one
  source       String   @default("EXISTING_PEAK_DOCUMENT")
  status       String   @default("LINKED") // LINKED | SUPERSEDED
  verified     Boolean  @default(false) // a read-only lookup confirmed amount + accounts
  warning      String? // e.g. the document carries no contact, so only the figures matched
  note         String // why this link is right — required, and kept for the auditor
  linkedAt     DateTime @default(now())
  linkedById   String?
  createdAt    DateTime @default(now())

  @@unique([kind, sourceId])
  @@unique([documentType, documentNo])
  @@index([documentNo])
}
