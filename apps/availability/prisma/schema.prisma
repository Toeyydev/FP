// Folkpath availability prototype — data model.
// Availability = guide × date × 10 slots; assignment = guide × date × slot.
// Plus the account-provisioning layer (invite-led claim, OTP, access requests, audit).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  GUIDE
  OPERATOR
  ADMIN
}

enum AccountState {
  INVITED // code issued, not yet claimed
  PENDING // self-requested, awaiting operator approval
  ACTIVE // can log in
  SUSPENDED // access revoked without deleting the record
}

model User {
  id           String       @id @default(cuid())
  email        String       @unique
  passwordHash String? // null until the account is claimed
  role         Role         @default(GUIDE)
  state        AccountState @default(INVITED)
  displayName  String // nickname shown on the roster
  fullName     String?
  guideId      String?      @unique // G-001..G-025; null for operator/admin
  phone        String?
  languages    String[]     @default([])
  qualifications String[]   @default([]) // tour ids the guide can run
  consentAt    DateTime? // acknowledged handling customer booking data
  claimedAt    DateTime?
  createdAt    DateTime     @default(now())

  lineId       String? // LINE id/handle the guide typed (reference)
  lineUserId   String? @unique // real LINE Messaging API user id (captured on link)
  lineLinkCode String? // one-time code to link their LINE to this account
  emergencyName     String?
  emergencyPhone    String?
  emergencyRelation String?
  // Verified profile (sensitive PII — stored AES-encrypted via lib/crypto).
  taxId           String?
  idCardAddress   String?
  currentAddress  String?
  bankName        String?
  bankAccountNo   String?
  bankAccountName String?
  bankBranch      String?

  availability   Availability[]
  assignments    Assignment[]
  invites        Invite[]
  otps           Otp[]
  refreshTokens  RefreshToken[]
  passwordResets PasswordReset[]
  documents      GuideDocument[]
  notifications  Notification[]
}

// Company-wide whole-day blackout (holiday / closed day). Blocks all availability
// and assignments on that date.
model BlockedDate {
  id          String   @id @default(cuid())
  date        String   @unique // YYYY-MM-DD
  reason      String?
  createdById String?
  createdAt   DateTime @default(now())
}

// In-app notification for a guide (e.g. operator blocked a date they were free).
model Notification {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  message   String
  kind      String    @default("info")
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// Uploaded reference documents (ID card, bank book). Bytes stored AES-encrypted.
model GuideDocument {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  kind       String // ID_CARD | BANK_BOOK
  filename   String
  mimeType   String
  size       Int
  data       Bytes // encrypted
  uploadedAt DateTime @default(now())

  @@index([userId])
}

model Tour {
  id   String @id // T-001..T-009
  name String
  time String

  // Operator-maintained tour info, shown to assigned guides.
  meetingPoint String?
  itinerary    String?
  included     String?
  bring        String?
  durationMin  Int? // default tour length (prefills offer duration)

  assignments Assignment[]
}

model Availability {
  id      String    @id @default(cuid())
  guideId String
  guide   User      @relation(fields: [guideId], references: [guideId], onDelete: Cascade)
  date    String // "YYYY-MM-DD"
  slots   Boolean[]

  updatedAt DateTime @updatedAt

  @@unique([guideId, date])
  @@index([date])
}

model Assignment {
  id      String  @id @default(cuid())
  guideId String
  guide   User    @relation(fields: [guideId], references: [guideId], onDelete: Cascade)
  date    String
  slotIdx Int
  tourId  String
  tour    Tour    @relation(fields: [tourId], references: [id])
  pax     Int?
  note    String?

  createdAt DateTime @default(now())

  @@unique([guideId, date, slotIdx])
  @@index([date])
}

// Single-use, expiring invite. Code shown to the user is `selector-secret`;
// `selector` is the indexed lookup, `secretHash` is the bcrypt of the secret.
model Invite {
  id          String    @id @default(cuid())
  selector    String    @unique
  secretHash  String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  role        Role
  channel     String    @default("email")
  sentTo      String? // masked destination, for display
  expiresAt   DateTime
  usedAt      DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  @@index([userId])
}

// One-time code for claim identity verification. Short-lived, rate-limited.
model Otp {
  id         String    @id @default(cuid())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  purpose    String    @default("CLAIM_VERIFY")
  codeHash   String
  channel    String    @default("email")
  sentTo     String?
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  lastSentAt DateTime  @default(now())
  createdAt  DateTime  @default(now())

  @@index([userId])
}

enum RequestState {
  PENDING
  APPROVED
  REJECTED
}

// Self-service "request access" queue. Kept separate from User so an unverified
// stranger never gets a User row until an operator links them to a guide record.
model AccessRequest {
  id              String       @id @default(cuid())
  name            String // full name
  nickname        String? // shown to operators on the roster
  passwordHash    String? // self-set at sign-up; copied onto the guide account on approval
  phone           String?
  email           String
  believedGuideId String?
  state           RequestState @default(PENDING)
  linkedUserId    String?
  reviewedById    String?
  reviewedAt      DateTime?
  note            String?
  createdAt       DateTime     @default(now())

  @@index([state])
}

// "Remember me" persistent session. Opaque token, only its SHA-256 hash is stored.
// Rotated on every use; `family` ties a rotation chain so reuse can revoke the lot.
model RefreshToken {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String    @unique
  family    String
  userAgent String?
  expiresAt DateTime
  rotatedAt DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([family])
}

// Single-use, time-limited password reset. Only the token hash is stored.
model PasswordReset {
  id         String    @id @default(cuid())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  actorRole  String?
  action     String // invite.issued | invite.claimed | otp.sent | request.created | ...
  entityType String?
  entityId   String?
  detail     Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// A job offered to the available guides. Broadcast to everyone marked available
// for the slot; first to Accept wins (atomic). Expires + alerts the operator if
// nobody accepts in time. status: OPEN | ASSIGNED | EXPIRED | CANCELLED.
model JobOffer {
  id              String   @id @default(cuid())
  tourId          String
  date            String // "YYYY-MM-DD"
  slotIdx         Int
  durationMin     Int? // how long the tour runs, so the guide sees when it ends
  pax             Int?
  note            String?
  status          String   @default("OPEN")
  assignedGuideId String?
  expiresAt       DateTime
  createdById     String?
  createdAt       DateTime @default(now())

  responses JobOfferResponse[]

  @@index([status])
  @@index([date])
}

// A booking imported from a channel (Bokun webhook → GYG/Viator) or added by
// hand. Gathered in the Bookings Inbox, grouped by date+tour+slot, then turned
// into a job offer. `raw` keeps the full payload so parsing can be refined.
model Booking {
  id               String   @id @default(cuid())
  source           String   @default("bokun") // bokun | gyg | viator | manual
  externalId       String? // Bokun booking id
  confirmationCode String? // e.g. GYG6H797YG86
  productName      String?
  tourId           String? // mapped to our Tour (null until mapped)
  date             String? // "YYYY-MM-DD" start date
  startTime        String? // "HH:MM"
  slotIdx          Int? // mapped slot index
  pax              Int?
  customerName     String?
  status           String   @default("PENDING") // PENDING | OFFERED | ASSIGNED | CANCELLED | IGNORED
  raw              Json?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([source, externalId])
  @@index([date])
  @@index([status])
}

// Learned mapping: a channel product name → our Tour. Set the first time an
// operator maps a booking's product; future bookings of that product auto-map.
model ProductMap {
  id          String   @id @default(cuid())
  productKey  String   @unique // normalized product name
  productName String
  tourId      String
  updatedAt   DateTime @updatedAt
}

// The full Folkpath job sheet for one assigned job (guide × date × slot).
// Living document: the operator edits pax/costs/tickets anytime and re-saves.
// bookings / expenses / guideFee are JSON so rows can be added/removed freely.
model JobSheet {
  id        String   @id @default(cuid())
  ref       String? // FOLK-BKK-YYYYMMDD-NN
  guideId   String
  date      String // "YYYY-MM-DD"
  slotIdx   Int
  tourId    String
  status    String   @default("Confirmed")
  bookings  Json     @default("[]") // [{name, bookingNo, bookedPax, actualPax, tickets, status}]
  expenses  Json     @default("[]") // [{description, price, pax}]
  guideFee  Json     @default("{}") // {price, time, whtPct}
  createdById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([guideId, date, slotIdx])
  @@index([date])
}

// One row per guide the offer touched: OFFERED when sent, then ACCEPTED/DENIED.
model JobOfferResponse {
  id          String   @id @default(cuid())
  offer       JobOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  offerId     String
  guideId     String
  response    String   @default("OFFERED") // OFFERED | ACCEPTED | DENIED
  respondedAt DateTime @default(now())

  @@unique([offerId, guideId])
  @@index([offerId])
}
