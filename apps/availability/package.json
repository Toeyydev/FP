{
  "name": "folkpath-availability",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:setup": "prisma migrate dev --name init && prisma db seed",
    "typecheck:worker": "tsc --noEmit -p tsconfig.worker.json",
    "build:worker": "esbuild src/workers/payment-worker.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/worker/payment-worker.js --external:@prisma/client --external:.prisma/client --tsconfig=tsconfig.worker.json",
    "worker": "node dist/worker/payment-worker.js"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "@simplewebauthn/browser": "^9.0.1",
    "@simplewebauthn/server": "^9.0.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "bcryptjs": "^2.4.3",
    "exceljs": "^4.4.0",
    "next": "^15.1.4",
    "next-auth": "5.0.0-beta.25",
    "nodemailer": "^8.0.10",
    "prisma": "^6.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/web-push": "^3.6.4",
    "esbuild": "^0.24.2",
    "vitest": "^4.1.8"
  }
}
